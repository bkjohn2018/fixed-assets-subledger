{
  "name": "CapExLifecycle",
  "id": "CapExLifecycle",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"D_Asset\",\"D_Book\",\"D_COA\",\"D_Time\",\"D_Project\",\"D_Task\",\"F_Asset_Balance_Period\",\"F_Asset_Transaction\",\"F_Depreciation_Period\",\"F_Project_Cost\",\"F_Project_Asset_Line\",\"B_Project_Cost_To_Asset_Line\",\"F_Project_Capitalization_Status\"]"
      },
      {
        "name": "_RepoReadme",
        "value": "Stub tables keep the bus shape for this repo. Swap each partition M for the CSV loaders in powerbi/queries/<domain>/ (point File.Contents at ../../data/... from this folder), then import powerbi/measures.dax in Tabular Editor or Desktop."
      }
    ],
    "tables": [
      {
        "name": "D_Project",
        "columns": [
          {
            "name": "PROJECT_ID",
            "dataType": "Int64",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "D_Project",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [PROJECT_ID = Int64.Type], {}) in Source"
            }
          }
        ]
      },
      {
        "name": "D_Task",
        "columns": [
          {
            "name": "TASK_ID",
            "dataType": "Int64",
            "summarizeBy": "none"
          }
